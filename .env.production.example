# Продакшен. Скопировать на сервер как .env.production и заполнить.
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# TLS и домен — на стороне системного nginx (deploy/md-note.nginx.conf),
# поэтому здесь домен нужен только один раз, для Auth.js.

# Внешний адрес сайта, обязательно https и без слеша на конце.
# Отсюда Auth.js строит callback URL — если не совпадёт с тем, что
# прописано у OAuth-провайдера, вход будет падать с redirect_uri_mismatch.
AUTH_URL=https://notes.example.com

# Postgres. Пароль — длинный и случайный: openssl rand -base64 24
POSTGRES_USER=mdnote
POSTGRES_PASSWORD=
POSTGRES_DB=mdnote
# Хост здесь — имя сервиса из compose, а не localhost.
DATABASE_URL=postgresql://mdnote:ЗАМЕНИ_НА_ПАРОЛЬ@postgres:5432/mdnote

# openssl rand -base64 32
AUTH_SECRET=

# Callback URL: https://<DOMAIN>/api/auth/callback/<провайдер>
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

AUTH_YANDEX_ID=
AUTH_YANDEX_SECRET=

AUTH_VK_ID=
AUTH_VK_SECRET=

# ОБЯЗАТЕЛЬНО заполнить: иначе зарегистрироваться сможет любой,
# кто нашёл сайт. Список email через запятую.
ALLOWED_EMAILS=

# Семантический поиск — MWS GPT Model Hub. Необязательно:
# пусто = поиск остаётся полнотекстовым. Имя проекта — часть URL.
MWS_BASE_URL=
MWS_API_KEY=
MWS_EMBEDDING_MODEL=bge-m3

# Модель для ответов на вопросы по заметкам. Имя ДЕПЛОЯ, а не строка из
# каталога: в каталоге qwen3.6-35b-a3b, в API qwen3-6-35b-a3b. Проверить —
#   curl -s -H "Authorization: Bearer $MWS_API_KEY" "$MWS_BASE_URL/models"
# Пусто = поиск работает, кнопки «Спросить у заметок» нет.
MWS_CHAT_MODEL=

# Вложения лежат в томе uploads-data, путь задан в Dockerfile.
# Переопределять UPLOADS_DIR здесь не нужно.
