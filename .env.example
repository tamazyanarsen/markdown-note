# Скопируй в .env и заполни: cp .env.example .env

# --- База данных -----------------------------------------------------------
# Совпадает с docker-compose.yml для локальной разработки.
DATABASE_URL=postgresql://mdnote:mdnote@localhost:5432/mdnote

# --- Auth.js ---------------------------------------------------------------
# Сгенерировать секрет: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# За реверс-прокси Auth.js должен доверять заголовкам X-Forwarded-*.
AUTH_TRUST_HOST=true

# --- OAuth-провайдеры ------------------------------------------------------
# Каждый провайдер необязателен: если пара ID/SECRET пуста,
# кнопка входа для него просто не показывается.

# GitHub — https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Яндекс — https://oauth.yandex.ru/client/new
# Callback URL: http://localhost:3000/api/auth/callback/yandex
# Права доступа: login:email, login:info
AUTH_YANDEX_ID=
AUTH_YANDEX_SECRET=

# VK ID — https://id.vk.com/business/go
# Callback URL: https://<домен>/api/auth/callback/vk
# ВНИМАНИЕ: VK не принимает localhost в redirect URI, поэтому вход через VK
# заработает только после того, как появится домен с HTTPS.
AUTH_VK_ID=
AUTH_VK_SECRET=

# --- Доступ ----------------------------------------------------------------
# Список email через запятую, которым разрешён вход.
# Пусто = вход открыт всем, кто нашёл сайт. Для публичного сервера — заполнить.
ALLOWED_EMAILS=
